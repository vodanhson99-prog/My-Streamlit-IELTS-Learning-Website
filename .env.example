# Server-side AI Examiner Configuration (9router / OpenAI compatible)
AI_API_KEY=
AI_API_URL=https://9router.minhmice.com/v1/chat/completions
AI_MODEL=coding-rbs
# Per-request upstream timeout in milliseconds. Combined Writing evaluation may take several minutes.
AI_TIMEOUT_MS=120000

# External IELTS Mock Test Catalog Source
IELTS_ONLINE_TESTS_BASE_URL=https://ieltsonlinetests.com

# Used only by `pnpm iot:login` to spawn cookies into credential/cookies.json
# Do not commit real values. Cookies (not password) are what the app reuses.
IOT_EMAIL=
IOT_PASSWORD=

